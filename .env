# =============================================================
# Environment Variables for User Management API
# =============================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# When running with Docker Compose, DB_HOST should be the service name 'db'
# When running locally (without Docker), use 'localhost'
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=usersdb
